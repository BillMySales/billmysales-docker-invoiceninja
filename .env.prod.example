# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only), tools
# (console).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=invoiceninja

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below). TRAEFIK_HOST is REQUIRED with it (no default).
#TRAEFIK_HOST=billing.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of Invoice Ninja: the app, the client portal
# (<url>/client) and the API (<url>/api/v1). Applied on every `up`.
NINJA_URL=https://billing.example.com
# Address of the client portal in emails, if different from NINJA_URL
# (rewritten on every `up`).
#NINJA_PORTAL_URL=
# The app only answers to the hosts of NINJA_URL, NINJA_PORTAL_URL and these
# (comma separated), e.g. www.example.com; other Host headers get HTTP 400.
#NINJA_EXTRA_HOSTS=
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=billing.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
# The company's time zone, set once on the first install (later changes in
# the app are kept); also the containers' TZ on every start (little effect:
# Laravel works in SERVER_TIMEZONE, UTC by default).
#TIMEZONE=America/Santiago

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED)
# ---------------------------------------------------------------------------
# Laravel encryption key (encrypts gateway credentials and other secrets):
# "base64:" + openssl rand -base64 32. Keep a copy: backups need it.
APP_KEY=
# openssl rand -hex 32
DB_PASSWORD=
DB_ROOT_PASSWORD=
# First admin user (created on the first run; its password is set only then).
NINJA_ADMIN_EMAIL=
NINJA_ADMIN_PASSWORD=
#DB_USER=ninja
#DB_NAME=ninja

# ---------------------------------------------------------------------------
# Company (initial settings, applied only on the first install; later changes
# in the app are kept)
# ---------------------------------------------------------------------------
#NINJA_COMPANY_NAME=Invoice Ninja
#NINJA_CURRENCY=CLP
#NINJA_COUNTRY=CL
# Language of the app, the client portal, emails and PDFs (a locale of
# Invoice Ninja's languages table). es_ES: Invoice Ninja's "es" translation
# has broken placeholders in email subjects ("Nueva factura :invoice").
#NINJA_LANGUAGE=es_ES
#NINJA_DATE_FORMAT=d/m/Y
# Default tax of new invoices (%); empty = none.
#NINJA_TAX_RATE=19
#NINJA_TAX_NAME=IVA
# Line prices include tax (false: IVA added on top, as usual in B2B invoices).
#NINJA_PRICES_INCLUDE_TAX=false

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Invoice Ninja image (invoiceninja/invoiceninja-debian). After changing it,
# `docker compose up -d` pulls it and setup runs the migrations. Back up
# first.
#NINJA_VERSION=5.13.43
#MYSQL_VERSION=8.4
#REDIS_VERSION=7.4
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31
# Mailpit's web UI (development only).
#MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# Mail (SMTP, recommended): invoices, quotes, payment receipts, reminders,
# notifications. Without SMTP_HOST no emails are sent (they are written to
# the log instead).
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# tls (STARTTLS, usually port 587), ssl (SMTPS, port 465) or none.
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Sender address and name.
#SMTP_FROM=noreply@example.com
#SMTP_FROM_NAME=Invoice Ninja

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# Resources and logs
# ---------------------------------------------------------------------------
#UPLOAD_MAX_SIZE=32M
#DB_MEMORY_LIMIT=1g
#REDIS_MEMORY_LIMIT=256m
#SETUP_MEMORY_LIMIT=1g
#APP_MEMORY_LIMIT=1g
#WORKER_MEMORY_LIMIT=1g
#SCHEDULER_MEMORY_LIMIT=512m
#CADDY_MEMORY_LIMIT=256m
#CONSOLE_MEMORY_LIMIT=1g
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
