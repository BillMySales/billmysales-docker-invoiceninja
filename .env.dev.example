# Development environment: cp .env.dev.example .env && docker compose up -d
# Public example values: never use them on a server (see .env.prod.example).
COMPOSE_PROFILES=mailpit

NINJA_URL=http://localhost:8116
SITE_ADDRESS=:80
HTTP_PORT=8116
HTTPS_PORT=8416
MAILPIT_PORT=8025

APP_KEY=base64:ZGV2LWFwcC1rZXktZGV2LWFwcC1rZXktZGV2LTAwMDA=
DB_PASSWORD=ninja
DB_ROOT_PASSWORD=root
NINJA_ADMIN_EMAIL=admin@example.com
NINJA_ADMIN_PASSWORD=admin12345
NINJA_COMPANY_NAME=Empresa

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=billing@example.com
SMTP_FROM_NAME=Empresa
