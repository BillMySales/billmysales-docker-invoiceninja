# Caddy in front of Invoice Ninja's PHP-FPM: TLS, static files, the front
# controller and security headers (from the official image's nginx config,
# Laravel's recommended one).
#
# /var/www/html/public is the `public` volume (copied from the image by
# setup) and /var/www/html/storage the `storage` volume: public/storage is a
# symlink into it (uploaded logos and documents).
{
	# No admin API: config is static, reloads happen by restarting the container.
	admin off

	servers {
		# Behind a reverse proxy on a private network, log the real client IP
		# (X-Forwarded-For) and pass X-Forwarded-Proto on to Laravel.
		trusted_proxies static private_ranges
		# Client IP = the right-most untrusted address (can't be spoofed).
		trusted_proxies_strict
	}
}

(ninja) {
	root * /var/www/html/public
	encode zstd gzip

	request_body {
		max_size {$UPLOAD_MAX_SIZE}
	}

	# One directive per header: in a single `header { }` block, Caddy applies
	# the "?" (set if missing) fields together, only when all are missing.
	header ?X-Content-Type-Options nosniff
	header ?X-Frame-Options SAMEORIGIN
	header ?Referrer-Policy strict-origin-when-cross-origin
	header -Server
	header -X-Powered-By

	# Dotfiles (but .well-known) and PHP files other than the front controller
	# are never served.
	@blocked {
		path /.* */.* *.php
		not path /.well-known/* /index.php
	}
	handle @blocked {
		respond 404
	}

	@assets path /bundle/* /build/* /react/* /*.js /*.css /*.woff2
	header @assets Cache-Control "public, max-age=604800"

	handle {
		php_fastcgi app:9000 {
			root /var/www/html/public
			env REMOTE_ADDR {client_ip}
			# Invoice Ninja records Cf-Connecting-Ip or else X-Forwarded-For as
			# is (the whole chain, which a client can forge): pass only the real
			# client IP.
			header_up X-Forwarded-For {client_ip}
			header_up -Cf-Connecting-Ip
		}
		file_server
	}
}

# Public site. SITE_ADDRESS is ":80" for plain HTTP (local, or behind another
# proxy) or a domain name, which makes Caddy obtain and renew a certificate
# automatically ("localhost" uses Caddy's internal CA).
{$SITE_ADDRESS} {
	import ninja
	log {
		output stdout
	}
}

# Internal-only site (port not published) for the container healthcheck.
:8080 {
	import ninja
}
